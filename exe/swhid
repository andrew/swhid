#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "swhid"
require "json"
require "tempfile"

$stdout.binmode

class SwhidCLI
  class UsageError < StandardError; end

  FORMATS = %w[text raw json jsonl].freeze

  def initialize(args)
    @args = args.dup
    @options = { format: "text", qualifiers: {} }
  end

  def run
    @command = @args.shift || "help"
    if %w[version -version --version].include?(@command)
      puts "swhid #{Swhid::VERSION}"
      return
    end

    parse_options!
    raise UsageError, "Unsupported output format: #{@options[:format]} (expected #{FORMATS.join(', ')})" unless FORMATS.include?(@options[:format])

    if %w[help -h --help].include?(@command)
      show_help
      return
    end

    if @command == "parse" && !@options[:qualifiers].empty?
      raise UsageError, "Qualifiers cannot be added when parsing a SWHID"
    end

    swhid = case @command
            when "parse"
              require_arguments!(1, "Exactly one SWHID string is required")
              Swhid.parse(@args.first)
            when "content"
              require_arguments!(0, "Content is read from stdin; no arguments are accepted")
              compute_content_swhid
            when "directory"
              require_arguments!(1, "Exactly one directory path is required")
              Swhid::FromFilesystem.from_directory_path(@args.first)
            when "revision"
              require_arguments!(1..2, "Repository path and at most one reference are required")
              Swhid::FromGit.from_revision(@args[0], @args[1] || "HEAD")
            when "release"
              require_arguments!(2, "Repository path and tag name are required")
              Swhid::FromGit.from_release(*@args)
            when "snapshot"
              require_arguments!(1, "Exactly one repository path is required")
              Swhid::FromGit.from_snapshot(@args.first)
            else
              raise UsageError, "Unknown command: #{@command}"
            end

    unless @options[:qualifiers].empty?
      swhid = Swhid::Identifier.new(
        object_type: swhid.object_type,
        object_hash: swhid.object_hash,
        qualifiers: @options[:qualifiers]
      )
    end
    output_identifier(swhid)
  rescue UsageError => e
    warn "Error: #{e.message}"
    exit 2
  rescue => e
    warn "Error: #{e.message}"
    exit 1
  end

  def parse_options!
    positional = []
    until @args.empty?
      arg = @args.shift
      if arg == "--"
        positional.concat(@args)
        break
      end
      flag, value = arg.split("=", 2)
      case flag
      when "-f", "-format", "--format", "-q", "-qualifier", "--qualifier"
        value ||= @args.shift
        raise UsageError, "Argument required for #{flag}" unless value
        if %w[-f -format --format].include?(flag)
          @options[:format] = value
          next
        end

        key, qualifier_value = value.split("=", 2)
        if key.nil? || key.empty? || qualifier_value.nil?
          raise UsageError, "Invalid qualifier format: #{value} (expected KEY=VALUE)"
        end
        raise UsageError, "Duplicate qualifier: #{key}" if @options[:qualifiers].key?(key.to_sym)

        @options[:qualifiers][key.to_sym] = qualifier_value
      when "-h", "--help", "-help"
        warn <<~HELP
          Usage: swhid #{@command} [options]
            -f, --format FORMAT        Output format (#{FORMATS.join(', ')})
            -q, --qualifier KEY=VALUE  Add qualifier to a generated SWHID
            -h, --help                 Show command help
        HELP
        exit 0
      else
        raise UsageError, "Unknown option: #{arg}" if arg.start_with?("-") && arg != "-"

        positional << arg
      end
    end
    @args = positional
  end

  def require_arguments!(count, message)
    raise UsageError, message unless count === @args.length
  end

  def compute_content_swhid
    $stdin.binmode
    Tempfile.create("swhid-content", binmode: true) do |file|
      size = IO.copy_stream($stdin, file)
      file.rewind
      Swhid.from_content_io(file, size: size)
    end
  end

  def output_identifier(swhid)
    case @options[:format]
    when "raw"
      puts swhid.to_s
    when "json", "jsonl"
      data = {
        swhid: swhid.to_s,
        core: swhid.core_swhid,
        object_type: swhid.object_type,
        object_hash: swhid.object_hash,
        qualifiers: swhid.qualifiers.sort.to_h
      }
      puts(@options[:format] == "json" ? JSON.pretty_generate(data) : JSON.generate(data))
    else
      output_text(swhid)
    end
  end

  def output_text(swhid)
    puts "SWHID: #{swhid.to_s}"
    puts "Core:  #{swhid.core_swhid}"
    puts "Type:  #{swhid.object_type}"
    puts "Hash:  #{swhid.object_hash}"

    unless swhid.qualifiers.empty?
      puts "Qualifiers:"
      swhid.qualifiers.sort.each do |key, value|
        puts "  #{key}: #{value}"
      end
    end
  end

  def show_help
    puts <<~HELP
      swhid - Generate and parse SoftWare Hash IDentifiers

      Usage:
        swhid parse [options] <swhid>          Parse and validate a SWHID
        swhid content [options]                Generate SWHID for content from stdin
        swhid directory [options] <path>       Generate SWHID for a directory
        swhid revision [options] <repo> [ref]  Generate SWHID for a Git revision
        swhid release [options] <repo> <tag>   Generate SWHID for a Git release
        swhid snapshot [options] <repo>        Generate SWHID for a Git snapshot
        swhid version                          Show the swhid version

      Options:
        -f, --format FORMAT              Output format (text, raw, json, jsonl)
        -q, --qualifier KEY=VALUE        Add qualifier to a generated SWHID
        -h, --help                       Show command help
            --version                    Show the swhid version

      Examples:
        swhid parse swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2
        cat file.txt | swhid content
        swhid directory /path/to/dir -f raw
        swhid revision /path/to/repo main
        swhid release /path/to/repo v1.0.0
        swhid snapshot /path/to/repo
        cat file.txt | swhid content -q origin=https://github.com/example/repo
        swhid parse -f json swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2
    HELP
  end
end

SwhidCLI.new(ARGV).run
